mainmenu "I2S Loopback Test"

source "Kconfig.zephyr"

config I2S_TEST_SEPARATE_DEVICES
	bool "Use two separate I2S ports for loopback"
	help
	  Use separate I2S ports for transmit and receive.

config I2S_TEST_USE_I2S_DIR_BOTH
	bool "Use I2S_DIR_BOTH value to perform RX/TX transfers"
	default y if DT_HAS_NORDIC_NRF_I2S_ENABLED || DT_HAS_NORDIC_NRF_TDM_ENABLED
	help
	  Use the I2S_DIR_BOTH enumeration value to trigger commands in test
	  cases involving both reception and transmission. Use of this option
	  is essential for devices that cannot independently start and stop
	  the RX and TX streams.

config I2S_TEST_USE_GPIO_LOOPBACK
	bool "Use GPIO loopback"
	default y if DT_HAS_NORDIC_NRF_I2S_ENABLED || DT_HAS_NORDIC_NRF_TDM_ENABLED
	help
	  Use wiring between the data-out and data-in pins for looping back
	  data. This option is intended to be used for devices that do not
	  provide the internal loopback functionality.

config I2S_TEST_RX_CLK_CONTROLLER
	bool "Configure the RX stream as clock controller"
	help
	  Configure the RX stream with a bit and frame clock controller
	  Options instead of the target options. Needed for devices whose RX stream is clocked by
	  the same clock generator as the TX stream and cannot act as clock target.

config I2S_TEST_BIT_CLK_GATED
	bool "Request a gated bit clock"
	help
	  Set I2S_BIT_CLK_GATED instead of I2S_BIT_CLK_CONT in every stream configuration.
	  Needed for devices that only clock the bus while data is transferred.

config I2S_TEST_ALLOWED_DATA_OFFSET
	int "Allowed offset in received data"
	default 2 if DT_HAS_NORDIC_NRF_I2S_ENABLED || DT_HAS_NORDIC_NRF_TDM_ENABLED
	default 2 if DT_HAS_SILABS_USART_I2S_ENABLED
	default 0
	help
	  Maximum allowed offset between sent and received samples. Non-zero
	  value of this option may be needed when GPIO loopback is used.

config I2S_TEST_ALLOW_VARIABLE_OFFSET
	bool "Recalculate the data offset on every block read"
	default n
	help
	  If the data offset is not consistent between reads because of
	  timing variations in the hardware, enable this option to
	  always recalculate the offset.

config I2S_TEST_SKIP_RX_SYNC_START
	bool "Skip test_i2s_rx_sync_start"
	help
	  Skip the late-RX-start case when the first received block may not
	  yet contain loopback data (e.g. gated bit clock on GPIO loopback).
