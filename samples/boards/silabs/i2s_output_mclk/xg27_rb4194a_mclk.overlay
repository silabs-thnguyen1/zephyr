/*
 * LOCAL ONLY — do not push. EXTRA overlay for samples/drivers/i2s/output.
 *
 * Adds CMU CLKOUT2 MCLK on PB0 (EXP7): EXPORTCLK / 32 ≈ 2.4 MHz.
 * Base I2S pins come from sample boards/xg27_rb4194a.overlay
 * (PC0 TX, PC2 BCLK, PC3 WS).
 *
 * PB0 is shared with LED0 / button0 — disable those so CLKOUT owns the pin.
 * Probe: MCLK=EXP7, BCLK=EXP8, WS=EXP10, SD=EXP4.
 */

#include <zephyr/dt-bindings/pinctrl/silabs/xg27-pinctrl.h>

&led0 {
	status = "disabled";
};

&button0 {
	status = "disabled";
};

&pwm_led0 {
	status = "disabled";
};

&usart0 {
	silabs,mclk-out = <&clkout2>;
};

&pinctrl {
	clkout_default: clkout_default {
		group0 {
			pins = <CMU_CLKOUT2_PB0>;
			drive-push-pull;
		};
	};
};

&exportclk {
	clock-div = <32>;
};

&clkout {
	pinctrl-0 = <&clkout_default>;
	pinctrl-names = "default";
	clock-div = <1>;
	status = "okay";
};

&clkout2 {
	clocks = <&exportclk>;
	status = "okay";
};
